allow[compiler:error.error-message]end

action:note, remark:'Counting to five, out loud.'end

privacy:local, memory:automatic, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.end: "count" = '0'end

action:repetition, while:"count" less-than '5',
  do:
    action:assign, target:"count", value:"count" plus '1'end
    action:say, source:"count"end
  end-repetition