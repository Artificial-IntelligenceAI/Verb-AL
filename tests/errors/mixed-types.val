allow[compiler:error.error-message]end
requires:target.64-bit-pointers.little-endian.8-byte-maximum-alignment end

privacy:local, memory:automatic, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.end: "whole" = '1'end
privacy:local, memory:automatic, type:float.1-sign-bit.8-exponent-bits.23-explicit-mantissa-bits, name.string.end: "fraction" = '1.5'end
privacy:local, memory:automatic, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.space.end: "written one" = "whole" plus "fraction"end
standard-output:print.variable.newline-too.end:[(privacy:local, memory:automatic, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.space.end: "written one" = "whole" plus "fraction"end)]end