allow[compiler:error.error-message]end

action:note, remark:'Text is a pointer and a length; joining allocates, comparing walks the bytes.'end

privacy:local, memory:automatic, type:text.utf-8.pointer-and-length, name.string.end: "greeting" = 'hello'end
privacy:local, memory:automatic, type:text.utf-8.pointer-and-length, name.string.end: "empty" = ''end

action:assign, target:"greeting", value:"greeting" joined-with ', world'end
standard-output:print.newline-too.end:[("greeting")]end
standard-output:print.newline-too.end:[("greeting" equal-to 'hello, world')]end
standard-output:print.newline-too.end:[("greeting" equal-to 'hello')]end
standard-output:print.newline-too.end:[("greeting" not-equal-to 'hello')]end
standard-output:print.newline-too.end:[("empty" joined-with "empty")]end
standard-output:print.newline-too.end:[("empty" equal-to '')]end
standard-output:print.string.newline.tab.newline-too.end:["lines\nand\ttabs"]end