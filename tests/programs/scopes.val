allow[compiler:error.error-message]end

action:note, remark:'A block is a scope, so the same name may be declared again after it closes.'end

privacy:local, memory:automatic, type:truth.1-bit, name.string.end: "go" = 'true'end

action:branch, condition:"go",
  then:
    privacy:local, memory:automatic, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.end: "inner" = '1'end
    standard-output:print.variable.newline-too.end:[(privacy:local, memory:automatic, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.end: "inner" = '1'end)]end
  end-branch

action:note, remark:'The second "inner" is a different variable with a different declaration, and each write must restate the one actually in scope.'end

action:branch, condition:"go",
  then:
    privacy:public, memory:static, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.end: "inner" = '2'end
    standard-output:print.variable.newline-too.end:[(privacy:public, memory:static, type:integer.1-sign-bit.31-value-bits.twos-complement, name.string.end: "inner" = '2'end)]end
  end-branch