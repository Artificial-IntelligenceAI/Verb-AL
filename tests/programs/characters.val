allow[compiler:error.error-message]end

action:note, remark:'Every UTF-8 length, encoded by the compiler and by Rust to the same bytes.'end

privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "one" = 'A'end
privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "two" = '\u{00E9}'end
privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "three" = '\u{4E2D}'end
privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "four" = '🤣'end

standard-output:print.end:[("one")]end
standard-output:print.end:[("two")]end
standard-output:print.end:[("three")]end
standard-output:print.end:[("four")]end
standard-output:print.end:[("one" less-than "four")]end