allow[compiler:error.error-message]end
requires:target.64-bit-pointers.little-endian.8-byte-maximum-alignment end

action:note, remark:'Every UTF-8 length, encoded by the compiler and by Rust to the same bytes.'end

privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "one" = 'A'end
privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "two" = '\u{00E9}'end
privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "three" = '\u{4E2D}'end
privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "four" = '🤣'end

standard-output:print.variable.newline-too.end:[(privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "one" = 'A'end)]end
standard-output:print.variable.newline-too.end:[(privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "two" = '\u{00E9}'end)]end
standard-output:print.variable.newline-too.end:[(privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "three" = '\u{4E2D}'end)]end
standard-output:print.variable.newline-too.end:[(privacy:local, memory:static, type:character.32-bits.unicode-scalar, name.string.end: "four" = '🤣'end)]end
privacy:local, memory:automatic, type:truth.1-bit, name.string.space.end: "written one" = "one" less-than "four"end
standard-output:print.variable.newline-too.end:[(privacy:local, memory:automatic, type:truth.1-bit, name.string.space.end: "written one" = "one" less-than "four"end)]end